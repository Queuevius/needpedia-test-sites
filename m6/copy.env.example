# Copy this file to a new name for each developer copy. Never commit a
# real one. Values shown are local development defaults only.

# Short unique name for this copy. Becomes container names, network, volume, Sablier group.
COPY_NAME=copy1

# Full hostname this copy answers to. Swap for a real DNS name on the server.
DOMAIN=copy1.needpedia.invalid

# http for local testing; https on a real server behind TLS.
DOMAIN_PROTOCOL=http

# Database name for THIS copy only. Two copies must not share this.
PG_DB=needpedia_copy1

# Local-only Postgres credentials. Not real service-account secrets.
PG_USER=needpedia
PG_PASSWORD=needpedia

# Optional local port for direct testing without the front door.
# 0 means "pick a random free port".
WEB_PORT=0

# Shared network the front door owns. Leave as-is.
FRONTEND_NETWORK=needpedia-front
